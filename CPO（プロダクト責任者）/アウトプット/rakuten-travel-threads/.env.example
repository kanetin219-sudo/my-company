# Rakuten Travel API
RAKUTEN_APPLICATION_ID=your_application_id_here
RAKUTEN_AFFILIATE_ID=your_affiliate_id_here

# Threads API
THREADS_USER_ID=your_threads_user_id_here
THREADS_ACCESS_TOKEN=your_access_token_here

# Search Keywords (comma-separated)
SEARCH_KEYWORDS=由布院,別府,福岡,熊本,宮崎,鹿児島,子連れ旅行,温泉宿,グランピング

# Timezone
TIMEZONE=Asia/Tokyo

# Post Hour (24-hour format, 0-23)
POST_HOUR=19
