[
  {"s": 0.0, "e": 1.5, "t": "犬が好きで、"},
  {"s": 1.6, "e": 4.5, "t": "「いつか、自分の手で\n\"うちの子\"を作れたら…」"},
  {"s": 4.6, "e": 6.0, "t": "そう思ったことは\nありませんか？"},
  {"s": 6.1, "e": 7.2, "t": "でも、"},
  {"s": 7.3, "e": 9.0, "t": "「羊毛フェルトって\n難しそう…」"},
  {"s": 9.1, "e": 10.5, "t": "「私にもできるのかな？」"},
  {"s": 10.6, "e": 12.0, "t": "そんな方も多いんです。"},
  {"s": 12.1, "e": 14.5, "t": "実は羊毛フェルトは、\n羊毛を専用の針で"},
  {"s": 14.6, "e": 16.5, "t": "チクチク刺しながら、\n少しずつ形を作っていく"},
  {"s": 16.6, "e": 18.0, "t": "手仕事なんです。"},
  {"s": 18.1, "e": 20.0, "t": "正しい順番で進めれば、\n初心者の方でも"},
  {"s": 20.1, "e": 22.5, "t": "\"うちの子\"らしい作品が\n作れるようになります。"},
  {"s": 22.6, "e": 24.5, "t": "完成した作品を見て、"},
  {"s": 24.6, "e": 26.5, "t": "「本当にうちの子みたい！」"},
  {"s": 26.6, "e": 28.5, "t": "「自分にも作れた！」"},
  {"s": 28.6, "e": 30.0, "t": "そんな喜びの声も\nたくさん届いています。"},
  {"s": 30.1, "e": 31.5, "t": "今なら、"},
  {"s": 31.6, "e": 34.0, "t": "写真から\"うちの子\"を\n再現する方法が学べる"},
  {"s": 34.1, "e": 36.0, "t": "無料講義動画を\nプレゼント中！"},
  {"s": 36.1, "e": 37.5, "t": "下のボタンから"},
  {"s": 37.6, "e": 39.0, "t": "LINE登録するだけで、"},
  {"s": 39.1, "e": 40.5, "t": "無料で受け取れます。"},
  {"s": 40.6, "e": 42.5, "t": "「私も作ってみたい」"},
  {"s": 42.6, "e": 44.5, "t": "そう思った方は、"},
  {"s": 44.6, "e": 46.0, "t": "ぜひ受け取ってください。"}
]
